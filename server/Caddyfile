# Caddy terminates TLS (free automatic certificates) so phones connect with wss://.
# DNS: an A record play.warfrontmandate.com → the server's IP address (Cloudflare: DNS only, grey cloud).
# Owner 2026-10-14 ("all the other games run off the website"): the same address also serves the
# browser version of the game. Game connections (WebSocket) go to the match server; everything
# else is the web game from /opt/warfront/web (kept up to date by server/web-sync.sh).
play.warfrontmandate.com {
	# Compress the game download (the engine shrinks from 35 MB to 9 MB) and let browsers keep
	# their copy: the second visit only checks the version instead of downloading it again.
	encode {
		zstd
		gzip
		match {
			header Content-Type text/*
			header Content-Type application/javascript*
			header Content-Type application/wasm*
			header Content-Type application/octet-stream*
			header Content-Type application/json*
		}
	}
	header /index.* Cache-Control "public, max-age=0, must-revalidate"
	@game_socket {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	@europe_socket {
		path /europe
		header Connection *Upgrade*
		header Upgrade websocket
	}
	reverse_proxy @europe_socket 127.0.0.1:8911
	reverse_proxy @game_socket 127.0.0.1:8910
	root * /opt/warfront/web
	file_server
}
