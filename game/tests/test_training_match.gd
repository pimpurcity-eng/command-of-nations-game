extends SceneTree
var checks := 0
var failures := 0
func check(ok: bool, message: String) -> void:
	checks += 1
	print("PASS " if ok else "FAIL ", message)
	if not ok: failures += 1
func _initialize() -> void: call_deferred("run")
func run() -> void:
	var game = load("res://scenes/main.tscn").instantiate()
	root.add_child(game)
	while not game.boot_finished: await process_frame
	game.mobile_start.country_picker.select(0)
	game.start_training()
	var training: TrainingMatch = game.training_match
	training.set_process(false)
	check(not game.mobile_start.visible, "training button opens the real game")
	check(game.session.training.phase == "choice" and game.clock.paused, "three tutorial routes are offered before playing")
	check(game.active_save_path() == TrainingScenario.SAVE_PATH and TrainingScenario.SAVE_PATH != game.SAVE_PATH, "training saves separately from normal campaigns")
	var army: Array = game.units.units
	check(army.filter(func(u): return u.country == "russia").size() == 16, "Russia starts with 16 troops")
	check(army.filter(func(u): return u.country == "ukraine").size() == 12, "Ukraine starts with 12 troops")
	check(army.all(func(u): return int(u.level) == 1), "every starting troop is level 1")
	check(army.filter(func(u): return u.equipment_id == "tanks_russia").size() == 5, "Russia has more tanks")
	check(army.filter(func(u): return u.equipment_id == "drones_ukraine").size() == 2, "Ukraine starts with drones")
	check(army.filter(func(u): return u.visual_kind == "fighter").all(func(u): return game.units.air.available(game.units.air.base(u), u.country)), "every aircraft and drone has a usable home airport")
	for country in ["russia", "ukraine"]:
		var capital: Dictionary = game.buildings.capital(country)
		check(game.buildings.level(capital.id, "drone_factory") == 1 and game.buildings.level(capital.id, "tank_plant") == 1, country + " has ready drone and tank facilities")
	check(game.buildings.level("lviv", "train_station") == 1 and game.buildings.level("odesa", "naval_base") == 1, "Lviv and Odesa terminals are ready")
	var income: Dictionary = game.production.gross_income()
	check(income.russia.funds > income.ukraine.funds, "Russia has a persistent money-income advantage")
	check(game.production.stockpiles.russia.funds > game.production.stockpiles.ukraine.funds, "Russia has the larger starting stockpile")
	game.production.scenario_income_factors.clear()
	var ordinary: float = game.production.city_income(game.buildings.capital("russia")).funds
	game.production.scenario_income_factors = TrainingScenario.INCOME_FACTORS.duplicate()
	check(is_equal_approx(game.production.city_income(game.buildings.capital("russia")).funds, ordinary * 1.5), "training income modifier is applied once")
	check(not game.match_rules.ai_enabled and game.match_rules.at_war, "training depicts an active war while holding the opponent AI during lessons")
	training.begin("full")
	check(game.session.training.phase == "opening" and game.clock.paused, "full route opens the first film with simulation paused")
	training.movie_finished()
	check(game.session.training.phase == "basics" and not game.clock.paused, "first film transitions to playable lessons")
	check(army.size() == 28 and game.session.training.aid_received.is_empty(), "opening film awards no reinforcements")
	training.next_step()
	check(game.session.training.step == 0, "Next cannot bypass an uncompleted action")
	var own_tank: Dictionary = game.units.units.filter(func(u): return u.country == GameSession.player_country and u.visual_kind == "armor")[0]
	var enemy_tank: Dictionary = game.units.units.filter(func(u): return u.country != GameSession.player_country and u.visual_kind == "armor")[0]
	game.units.select_unit(game.units.units.find(enemy_tank))
	check(not training.action_completed(), "enemy selection does not satisfy the own-tank objective")
	game.units.select_unit(game.units.units.find(own_tank))
	check(training.action_completed(), "real selection completes the first action")
	training.next_step()
	check(training.current_action() == "move" and not training.action_completed(), "movement requires a real order")
	check(game.units.order(game.map.position_at(game.buildings.city("voronezh").point)), "training tank accepts a movement order")
	check(training.action_completed(), "movement is detected from the real army")
	game.units.stop_selected()
	game.session.training.step = 2
	training.show_step()
	game.city_panel.open(game.buildings.capital(GameSession.player_country))
	training._process(0.31)
	check(training.action_completed() and not training.card.visible and is_instance_valid(training._menu_hint), "city action is detected with a nonblocking in-panel instruction")
	game.city_panel.hide()
	game.session.training.step = 3
	training.show_step()
	game.research_panel.open_unit("tanks_" + GameSession.player_country, 1)
	check(training.action_completed(), "opening the real unit card completes equipment inspection")
	game.research_panel.unit_card.hide()
	game.session.training.step = 4
	training.show_step()
	training._update_guidance(true)
	check(game.research.start("tanks_" + GameSession.player_country, 1).is_empty() and training.action_completed() and training._menu_hint.is_visible_in_tree(), "starting actual research completes the research objective with visible panel guidance")
	game.research_panel.hide()
	game.session.training.step = 5
	training.show_step()
	check(game.production.schedule("infantry_" + GameSession.player_country, game.buildings.capital(GameSession.player_country).name).is_empty() and training.action_completed(), "queuing actual infantry completes production")
	game.session.training.step = 6
	training.show_step()
	training.focus_objective()
	var drone: Dictionary = training._selected()
	check(not drone.is_empty() and game.units.air.order(drone, game.units.air.base(drone).point + Vector2(0.3, 0), "patrol").is_empty() and training.action_completed(), "real drone patrol completes the air objective")
	game.session.training.step = 7
	training.show_step()
	check(game.buildings.enqueue(game.buildings.capital(GameSession.player_country).id, "industry").is_empty() and training.action_completed(), "actual construction completes the building objective")
	game.session.training.phase = "features"
	game.session.training.step = 0
	training.show_step()
	training.focus_objective()
	check(training.action_completed(), "Show me opens the actual physical trade panel")
	game.session.training.step = 1
	training.show_step()
	check(not training.action_completed(), "world prices require the market tab")
	game.trade_panel.market_view = true
	check(training.action_completed(), "transport market tab completes the price objective")
	game.trade_panel.hide()
	game.session.training.step = 2
	training.show_step()
	check(game.match_rules.set_guard(GameSession.player_country, true).is_empty() and training.action_completed(), "Guard objective detects the actual defence toggle")
	game.match_rules.set_guard(GameSession.player_country, false)
	for index in [3, 4]:
		game.session.training.step = index
		training.show_step()
		training.focus_objective()
		check(training.action_completed(), "actual campaign panel completes " + training.current_action())
	game.campaign_panel.hide()
	game.session.training.phase = "basics"
	game.session.training.step = 0
	game.session.training.active_seconds = 0.0
	training.show_step()
	training._backgrounded = true
	var paused_seconds: float = game.session.training.active_seconds
	training._process(20.0)
	check(game.session.training.active_seconds == paused_seconds, "background time does not advance teaching")
	training._backgrounded = false
	training.advance_training(299.0)
	check(game.session.training.phase == "basics", "second film cannot interrupt the first five minutes")
	training.skip_lessons()
	check(game.session.training.phase == "practice", "skipping lessons preserves the later supply film")
	training.advance_training(1.0)
	check(game.session.training.phase == "supply_video" and game.clock.paused, "supply film starts after five foreground minutes")
	check(game.units.units.size() == 28 and game.session.training.aid_received.is_empty(), "aid is withheld until the second film finishes")
	var funds_before: float = game.production.stockpiles.ukraine.funds
	var earned_before: Dictionary = game.production.earned.duplicate(true)
	training.movie_finished()
	check(game.session.training.phase == "logistics", "supply film is followed by unloading lessons")
	check(game.units.units.size() == 28 and game.session.training.aid_pending.size() == 2, "both loads remain aboard after film two")
	check(training.supplies.vehicles.size() == 2 and training.supplies.vehicles.odesa.get_meta("loaded") and training.supplies.vehicles.lviv.get_meta("loaded"), "loaded ship and train exist on the actual map")
	check(training.supplies.vehicles.odesa.get_node("Weapons").get_child_count() == 5 and training.supplies.vehicles.lviv.get_node("Weapons").get_child_count() == 5, "both vehicles visibly carry five weapons")
	check(training.supplies.vehicles.odesa.get_node("Resources").get_child_count() == 4 and training.supplies.vehicles.lviv.get_node("Resources").get_child_count() == 0, "ship has resource crates; train carries weapons")
	check(game.production.stockpiles.ukraine.funds == funds_before, "loaded cargo has not credited money")
	check(game.autosave().is_empty(), "pending loaded cargo saves")
	game.start_training(true)
	training = game.training_match
	training.set_process(false)
	check(game.session.training.aid_pending.size() == 2 and game.units.units.size() == 28 and training.supplies.vehicles.size() == 2, "resume restores the two loaded vehicles without granting cargo")
	training.open_cargo("odesa")
	check(training._action_done(), "opening the ship completes the inspection objective")
	TrainingScenario.request_unload(game, "odesa")
	training.supplies.refresh()
	check(game.units.units.size() == 33 and game.session.training.aid_pending == ["lviv"], "unloading the ship leaves the train loaded")
	check(not training.supplies.vehicles.odesa.get_node("Weapons").visible and training.supplies.vehicles.lviv.get_node("Weapons").visible, "unloaded weapons disappear from the correct vehicle")
	check(game.units.units.filter(func(u): return str(u.equipment_id).begins_with("aid_american_")).size() == 5, "the American ship carries American hardware identities")
	check(game.units.units.filter(func(u): return u.id == "training_aid_odesa_fighters_0" and u.level == 1 and u.base_city == "odesa" and u.visual_kind == "fighter").size() == 1, "one of the five ship weapons is a level-1 plane with an Odesa airbase")
	check(not game.research.reason(TrainingScenario.aid_equipment("odesa", "tanks"), 1, "ukraine").is_empty(), "imported American equipment is not domestic research")
	TrainingScenario.request_unload(game, "lviv")
	training.supplies.refresh()
	check(game.units.units.size() == 38, "exactly ten level-1 weapons unload through the two terminals")
	training.cargo_overlay.hide()
	check(game.units.units.all(func(u): return int(u.level) == 1), "delivered equipment also remains level 1")
	check(game.production.stockpiles.ukraine.funds == funds_before + 40000.0, "American and European funds arrive with the cargo")
	check(game.production.earned == earned_before, "foreign aid creates no economic-victory income")
	for city_id in ["lviv", "odesa"]:
		check(game.units.units.filter(func(u): return str(u.id).begins_with("training_aid_" + city_id)).size() == 5, city_id + " unloads five equipment units")
	TrainingScenario.release_aid(game)
	training.movie_finished()
	check(game.units.units.size() == 38 and game.production.stockpiles.ukraine.funds == funds_before + 40000.0, "duplicate video callbacks cannot duplicate cargo or money")
	var saved: Dictionary = game.session.capture(game.clock, game.map, game.units, game.rig)
	var error: String = game.session.validate(saved, game.map, game.units)
	check(error.is_empty(), "training save validates: " + error)
	check(game.autosave().is_empty(), "training save writes")
	game.start_training(true)
	game.training_match.set_process(false)
	check(game.units.units.size() == 38 and game.session.training.aid_received.size() == 2, "resume retains deliveries")
	check(not game.match_rules.ai_enabled, "resume keeps opponent AI held until teaching ends")
	TrainingScenario.release_aid(game)
	check(game.units.units.size() == 38, "resume cannot replay the aid grant")
	game.mobile_start.show()
	game.training_match._process(0.1)
	check(not game.training_match.root.visible, "training overlay steps aside on the home screen")
	game.mobile_start.hide()
	game.training_match._process(0.1)
	check(game.training_match.root.visible, "training overlay returns when the match resumes")
	game.training_match.free_play()
	check(game.match_rules.ai_enabled and not game.clock.paused and game.session.training.phase == "free", "take command hands the live match to the player")
	game.start_training()
	training = game.training_match
	training.set_process(false)
	training.begin("features")
	check(game.session.training.phase == "features" and not game.clock.paused, "experienced-player route goes straight to new features")
	training.advance_training(600.0)
	check(game.session.training.phase == "supply_video", "teaching reaches the supply chapter by ten active minutes")
	training.movie_finished()
	check(game.units.units.size() == 28 and game.session.training.aid_pending.size() == 2, "feature-only route gets the same loaded vehicles")
	training.free_play()
	check(game.units.units.size() == 38, "skip logistics settles the remaining cargo once")
	game.start_training()
	training = game.training_match
	training.set_process(false)
	training.begin("skip")
	check(game.session.training.phase == "free" and game.units.units.size() == 38, "skip-all begins fair free play with the one-time arrival settled")
	var bad: Dictionary = game.session.capture(game.clock, game.map, game.units, game.rig)
	bad.training.active_seconds = -1
	check(not game.session.validate(bad, game.map, game.units).is_empty(), "corrupt training timers are rejected")
	bad = TrainingScenario.initial_state()
	bad.aid_received = ["lviv", "lviv"]
	check(not TrainingScenario.valid_state(bad), "duplicate delivery identifiers are rejected")
	game.start_training()
	training = game.training_match
	training.set_process(false)
	var port: Dictionary = game.buildings.city("odesa")
	game.match_rules.change_control(game.production.province(port), "russia")
	TrainingScenario.release_aid(game, true)
	check(game.session.training.aid_pending == ["odesa"] and game.units.units.size() == 33, "captured Odesa holds its cargo instead of spawning it for the enemy")
	game.match_rules.change_control(game.production.province(port), "ukraine")
	TrainingScenario.try_unload(game)
	check(game.session.training.aid_pending.is_empty() and game.units.units.size() == 38, "recovering Odesa unloads its pending cargo once")
	game.mobile_start.country_picker.select(1)
	game.start_training()
	training = game.training_match
	training.set_process(false)
	check(GameSession.player_country == "russia", "Russia is also playable in training")
	training.begin("full")
	check(training.movie.stream != null and game.clock.paused, "Russia sees the installed opening film")
	training.movie_finished()
	training.start_supply_movie()
	check(training.movie.stream != null and game.clock.paused, "Russia sees the installed supply film")
	training.movie_finished()
	training.open_cargo("odesa")
	TrainingScenario.request_unload(game, "odesa")
	check(game.units.units.filter(func(u): return str(u.id).begins_with("training_aid_odesa") and u.country == "ukraine").size() == 5, "watching as Russia still unloads Ukraine's five weapons for Ukraine")
	training.cargo_overlay.hide()
	game._clear_training()
	game.session.restore(game._campaign_initial_state, game.clock, game.map, game.units, game.rig)
	check(game.session.training.is_empty() and game.production.scenario_income_factors.is_empty(), "ordinary campaign state restores without training modifiers")
	game.queue_free()
	await process_frame
	print("RESULT TRAINING checks=%d failures=%d" % [checks, failures])
	quit(1 if failures else 0)
